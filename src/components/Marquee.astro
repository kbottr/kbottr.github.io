---
import Asterisk from '@lucide/astro/icons/asterisk';

// Big, endlessly scrolling title (Motto-style). The real <h1> stays for
// screen readers and search engines; the moving copy is decorative.
interface Props {
  text: string;
  repeat?: number;
  seconds?: number;
}
const { text, repeat = 4, seconds = 18 } = Astro.props;
const group = Array.from({ length: repeat });
---

<div class="marquee" style={`--dur:${seconds}s`}>
  <h1 class="sr-only">{text}</h1>
  <div class="track" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="group">
        {group.map(() => (
          <span class="item">{text}<Asterisk class="star" stroke-width={1.5} aria-hidden="true" /></span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .marquee {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    padding-block: var(--space-16);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    animation: rise var(--duration-slow) var(--ease) both;
  }
  @keyframes rise { from { opacity: 0; transform: translateY(var(--space-32)); } }
  .track { display: flex; width: max-content; animation: scroll var(--dur) linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .group { display: flex; flex-shrink: 0; }
  /* Display size runs from the 72px step to the 188px step of the type scale */
  .item {
    display: flex; align-items: center;
    font-size: clamp(var(--text-3xl), 16vw, var(--text-5xl));
    line-height: var(--leading-display);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
    padding-right: .3em;
  }
  /* Separator sized relative to the title (0.6 of its font size) */
  .item :global(.star) { flex-shrink: 0; width: .6em; height: .6em; margin-left: .3em; color: var(--muted); }
  @keyframes scroll { to { transform: translateX(-50%); } }
</style>
