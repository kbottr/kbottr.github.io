---
// Icons from Lucide (https://lucide.dev/icons/, ISC licence).
// To add one: find it on lucide.dev, import it from '@lucide/astro/icons/<name>'
// and add it to the map below.
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Briefcase from '@lucide/astro/icons/briefcase';
import Flag from '@lucide/astro/icons/flag';
import Headphones from '@lucide/astro/icons/headphones';
import House from '@lucide/astro/icons/house';
import Mail from '@lucide/astro/icons/mail';
import PenLine from '@lucide/astro/icons/pen-line';
import User from '@lucide/astro/icons/user';

const icons = {
  home: House,
  journal: PenLine,
  user: User,
  mail: Mail,
  briefcase: Briefcase,
  headphones: Headphones,
  flag: Flag,
  arrow: ArrowUpRight,
};

interface Props {
  name: keyof typeof icons;
  size?: number | string;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
const Lucide = icons[name];
---

<Lucide size={size} stroke-width={1.75} class={className} aria-hidden="true" />
