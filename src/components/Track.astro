---
// A music entry: cover, title + artist, and links to Spotify / Apple Music.
import Link from './Link.astro';
import Icon from './Icon.astro';
import { url } from '../site';

interface Props {
  title: string;
  artist: string;
  cover?: string;
  spotify?: string;
  apple?: string;
}
const { title, artist, cover, spotify, apple } = Astro.props;
const links = [
  spotify && { label: 'spotify', name: 'Spotify', href: spotify },
  apple && { label: 'apple music', name: 'Apple Music', href: apple },
].filter(Boolean) as { label: string; name: string; href: string }[];
---

<li class="track">
  {cover ? (
    <img class="cover" src={cover.startsWith('/') ? url(cover) : cover} alt="" width="48" height="48" loading="lazy" />
  ) : (
    <span class="cover placeholder" aria-hidden="true" />
  )}
  <span class="info">
    <span class="title">{title}</span>
    <span class="artist muted">{artist}</span>
  </span>
  {links.length > 0 && (
    <span class="links">
      {links.map((l) => (
        <Link variant="muted" href={l.href} target="_blank" rel="noopener" class="listen" aria-label={`${title} by ${artist} on ${l.name} (opens in a new tab)`}>
          {l.label}<Icon name="arrow-up-right" size="sm" />
        </Link>
      ))}
    </span>
  )}
</li>

<style>
  .track { display: flex; align-items: center; gap: var(--space-12) var(--space-16); flex-wrap: wrap; }
  .cover {
    width: var(--thumb); height: var(--thumb); flex-shrink: 0;
    border-radius: var(--radius); object-fit: cover;
  }
  .cover.placeholder { background: linear-gradient(135deg, var(--subtle), var(--line)); }
  .info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .artist { font-size: var(--text-sm); line-height: var(--leading-sm); }
  /* Same type as the artist name, sitting on the artist's line */
  .links {
    display: flex; gap: var(--space-16);
    align-self: flex-end;
    font-size: var(--text-sm); line-height: var(--leading-sm);
  }
  .links :global(.listen) { display: inline-flex; align-items: center; gap: var(--space-2); }

  /* Phones: links move under the title, aligned with the text */
  @media (max-width: 480px) {
    .links { flex-basis: 100%; padding-left: calc(var(--thumb) + var(--space-12)); }
  }
</style>
