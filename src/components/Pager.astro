---
// Back / next links at the end of a page.
import Link from './Link.astro';

interface Props {
  back: { href: string; label: string };
  next?: { href: string; label: string };
}
const { back, next } = Astro.props;
---

<nav class="pager">
  <Link href={back.href}>{back.label}</Link>
  {next && (
    <Link href={next.href}>next: {next.label}</Link>
  )}
</nav>

<style>
  .pager {
    display: flex; justify-content: space-between; gap: var(--space-16); flex-wrap: wrap;
    margin-top: var(--space-96);
    font-size: var(--text-sm); line-height: var(--leading-sm);
  }
</style>
