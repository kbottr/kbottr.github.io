---
// A challenge with a checkbox: empty while open, filled with a check
// (and struck-through text) when done. Optional subline underneath.
import Icon from './Icon.astro';

interface Props {
  done?: boolean;
  subline?: string;
}
const { done = false, subline } = Astro.props;
---

<li class:list={['challenge', { done }]}>
  <span class="box" aria-hidden="true">
    {done && <Icon name="check" size="sm" class="tick" />}
  </span>
  <span class="text">
    <span class="sr-only">{done ? 'done' : 'open'}:</span>
    {done ? <s><slot /></s> : <span><slot /></span>}
    {subline && <span class="subline muted">{subline}</span>}
  </span>
</li>

<style>
  .challenge { display: flex; align-items: flex-start; gap: var(--space-12); }
  .box {
    display: grid; place-items: center;
    width: var(--icon-sm); height: var(--icon-sm); flex-shrink: 0;
    /* centre the box on the first line of text */
    margin-top: calc((var(--leading-base) - var(--icon-sm)) / 2);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 var(--border) var(--muted);
  }
  .text { display: flex; flex-direction: column; min-width: 0; }
  .subline { font-size: var(--text-sm); line-height: var(--leading-sm); }

  .done { color: var(--muted); }
  .done .box { background: var(--fg); box-shadow: none; color: var(--bg); }
  .done .box :global(.tick) { width: var(--space-12); height: var(--space-12); stroke-width: 3; }
</style>
