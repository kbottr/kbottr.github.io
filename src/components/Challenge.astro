---
// A challenge with a real, toggleable checkbox and an optional subline.
// Checked items get scribbled out (shape generated by lib/scribble.ts).
// `done` sets the starting state from challenges.yaml; visitors can toggle
// items, but that only changes their own view and resets on reload.
import Icon from './Icon.astro';
import { scribble } from '../lib/scribble';

interface Props {
  done?: boolean;
  subline?: string;
}
const { done = false, subline } = Astro.props;

const text = await Astro.slots.render('default');
const mark = scribble(text.replace(/<[^>]+>/g, ''));
---

<li class:list={['challenge', { done, intro: done }]}>
  <label class="row">
    <input type="checkbox" class="sr-only toggle" checked={done} />
    <span class="box" aria-hidden="true">
      <Icon name="check" size="sm" class="tick" />
    </span>
    <span class="text">
      <span class="scribbled">
        <Fragment set:html={text} />
        <svg class="scribble" viewBox={`0 0 ${mark.width} 16`} preserveAspectRatio="none" aria-hidden="true">
          <path d={mark.d} pathLength="1" />
        </svg>
      </span>
      {subline && <span class="subline muted">{subline}</span>}
    </span>
  </label>
</li>

<style>
  .row { display: flex; align-items: flex-start; gap: var(--space-12); cursor: pointer; }
  .text { display: flex; flex-direction: column; min-width: 0; }
  .scribbled { position: relative; width: fit-content; transition: color var(--duration) var(--ease); }
  .subline { font-size: var(--text-sm); line-height: var(--leading-sm); }

  /* Checkbox drawing (the real input is visually hidden but focusable) */
  .box {
    display: grid; place-items: center;
    width: var(--icon-sm); height: var(--icon-sm); flex-shrink: 0;
    /* centre the box on the first line of text */
    margin-top: calc((var(--leading-base) - var(--icon-sm)) / 2);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 var(--border) var(--muted);
    color: var(--bg);
    transition: background var(--duration-fast), box-shadow var(--duration-fast);
  }
  .row:hover .box { box-shadow: inset 0 0 0 var(--border) var(--fg); }
  .toggle:focus-visible + .box { outline: var(--space-2) solid var(--accent); outline-offset: var(--space-2); }
  .box :global(.tick) {
    width: var(--space-12); height: var(--space-12); stroke-width: 3;
    opacity: 0; scale: .5;
    transition: opacity var(--duration-fast), scale var(--duration) var(--ease);
  }

  /* Checked */
  .done .scribbled { color: var(--muted); }
  .done .box { background: var(--fg); box-shadow: none; }
  .done .box :global(.tick) { opacity: 1; scale: 1; }

  /* Scribble: hidden until checked, then drawn like a pen stroke */
  .scribble {
    position: absolute;
    left: calc(-1 * var(--space-4));
    top: 50%; height: var(--space-12);
    translate: 0 -50%;
    width: calc(100% + 2 * var(--space-4));
    overflow: visible;
    pointer-events: none;
  }
  .scribble path {
    fill: none;
    stroke: var(--fg-soft);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* pathLength="1": one dash as long as the path, then a longer gap, so
       offset 1 = completely hidden (no round cap peeking out), 0 = fully drawn.
       (The box only stretches sideways, so the stroke keeps its thickness.) */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset calc(var(--duration-slow) * 1.5) var(--ease);
  }
  .done .scribble path { stroke-dashoffset: 0; }
  /* Items that start out done draw in once after the page has loaded */
  .intro .scribble path {
    animation: draw calc(var(--duration-slow) * 1.5) var(--ease) both;
    animation-delay: calc(var(--delay) + var(--duration));
  }
  @keyframes draw { from { stroke-dashoffset: 1; } }
</style>

<script>
  document.querySelectorAll<HTMLInputElement>('.challenge .toggle').forEach((input) => {
    input.addEventListener('change', () => {
      const item = input.closest('.challenge');
      item?.classList.remove('intro'); // hand over from the load animation to the toggle transition
      item?.classList.toggle('done', input.checked);
    });
  });
</script>
