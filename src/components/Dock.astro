---
import Icon from './Icon.astro';
import { site, url } from '../site';

// Which section is active, based on the current path.
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const section =
  path.startsWith('/work') ? 'work'
  : path.startsWith('/journal') ? 'journal'
  : path.startsWith('/about') ? 'about'
  : 'home';

const items = [
  { id: 'home', label: 'Home', href: url('/'), icon: 'home' },
  { id: 'work', label: 'Work', href: url('/work/'), icon: 'work' },
  { id: 'journal', label: 'Journal', href: url('/journal/'), icon: 'journal' },
  { id: 'about', label: 'About', href: url('/about/'), icon: 'user' },
] as const;
---

<nav class="dock" aria-label="Main">
  {items.map((item) => (
    <a
      href={item.href}
      class:list={['btn', { active: section === item.id }]}
      aria-current={section === item.id ? 'page' : undefined}
      data-label={item.label}
    >
      <Icon name={item.icon} />
      <span class="sr-only">{item.label}</span>
    </a>
  ))}
  <span class="sep" aria-hidden="true"></span>
  <a href={`mailto:${site.email}`} class="btn" data-label="Email">
    <Icon name="mail" />
    <span class="sr-only">Email</span>
  </a>
</nav>

<style>
  .dock {
    view-transition-name: dock;
    position: fixed; z-index: 50;
    left: 50%; bottom: calc(env(safe-area-inset-bottom) + var(--space-16));
    translate: -50% 0;
    display: flex; align-items: center; gap: var(--space-4);
    padding: var(--space-4);
    background: var(--dock-bg);
    border-radius: var(--radius-full);
    backdrop-filter: blur(var(--space-16)) saturate(1.4);
    /* Border drawn inside, so the dock stays exactly 48px (40 + 2 × 4) tall */
    box-shadow: inset 0 0 0 var(--border) var(--line), var(--shadow);
    animation: dock-in var(--duration-slow) var(--delay) var(--ease) both;
  }
  @keyframes dock-in { from { opacity: 0; translate: -50% var(--space-24); } }

  .btn {
    position: relative;
    display: grid; place-items: center;
    width: var(--control); height: var(--control);
    border: 0; border-radius: var(--radius-full);
    background: transparent; color: var(--muted);
    cursor: pointer;
    transition: background var(--duration-fast), color var(--duration-fast), transform var(--duration) var(--ease);
  }
  .btn:hover { background: var(--subtle); color: var(--fg); transform: translateY(calc(-1 * var(--space-2))); }
  .btn.active { background: var(--subtle); color: var(--fg); }

  /* Active page: icon moves up and a dot sits just below it, inside the circle */
  .btn :global(svg) { transition: translate var(--duration) var(--ease); }
  .btn.active :global(svg) { translate: 0 calc(-1 * var(--space-2)); }
  .btn.active::after {
    content: ''; position: absolute; left: 50%; bottom: var(--space-4);
    width: var(--dot); height: var(--dot); translate: -50% 0;
    border-radius: var(--radius-full);
    background: var(--fg);
  }

  /* Tooltip label */
  .btn::before {
    content: attr(data-label);
    position: absolute; bottom: calc(100% + var(--space-12)); left: 50%;
    translate: -50% var(--space-4);
    padding: var(--space-2) var(--space-8);
    border-radius: var(--radius-sm);
    background: var(--fg); color: var(--bg);
    font-family: var(--sans); font-size: var(--text-sm); line-height: var(--leading-sm);
    white-space: nowrap;
    opacity: 0; pointer-events: none;
    transition: opacity var(--duration-fast), translate var(--duration) var(--ease);
  }
  .btn:hover::before, .btn:focus-visible::before { opacity: 1; translate: -50% 0; }

  .sep { width: var(--border); height: var(--space-24); background: var(--line); margin-inline: var(--space-4); }
</style>
