---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
  // Give the element a shared name so it morphs between pages.
  morph?: boolean;
  eager?: boolean;
}

const { project, class: className, morph = true, eager = false } = Astro.props;
const { cover, colors, title } = project.data;
const [c1, c2, c3] = colors;
const style = [
  `--c1:${c1};--c2:${c2};--c3:${c3}`,
  morph && `view-transition-name:media-${project.id}`,
]
  .filter(Boolean)
  .join(';');
---

<div class:list={['media', className]} style={style}>
  <div class:list={['media-inner', !cover && 'placeholder']}>
    {cover && (
      <Image
        src={cover}
        alt={`${title} cover`}
        widths={[640, 1280, 1920]}
        sizes="(max-width: 900px) 100vw, 1400px"
        loading={eager ? 'eager' : 'lazy'}
      />
    )}
  </div>
</div>
