---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
  eager?: boolean;
}

const { project, class: className, eager = false } = Astro.props;
const { cover, colors, title } = project.data;
const [c1, c2, c3] = colors;
// The shared name makes the image morph between the home feed and the case study.
const style = `--c1:${c1};--c2:${c2};--c3:${c3};view-transition-name:media-${project.id}`;
---

<div class:list={['media', className]} style={style}>
  <div class:list={['media-inner', !cover && 'placeholder']}>
    {cover && (
      <Image
        src={cover}
        alt={`${title} cover`}
        widths={[640, 1240, 1860]}
        sizes="(max-width: 728px) 100vw, 680px"
        loading={eager ? 'eager' : 'lazy'}
      />
    )}
  </div>
</div>
