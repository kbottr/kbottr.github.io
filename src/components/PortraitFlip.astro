---
// Squircle portrait that flips over on click / tap to reveal a second image.
// Images: src/assets/portrait.(jpg|png|webp) for the front,
//         src/assets/portrait-back.(jpg|png|webp) for the back.
// Until they exist, placeholders are shown.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../site';

const fronts = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const backs = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait-back.{jpg,jpeg,png,webp}', { eager: true });
const front = Object.values(fronts)[0]?.default;
const back = Object.values(backs)[0]?.default;
const initials = site.name.split(' ').map((n) => n[0]).join('');
---

<button type="button" class="flip" aria-pressed="false" aria-label={`Flip ${site.name}'s portrait`}>
  <span class="tilt">
  <span class="card">
    <span class="face front">
      {front ? (
        <Image src={front} alt={site.name} width={224} height={224} loading="eager" />
      ) : (
        <span class="placeholder" aria-hidden="true">{initials}</span>
      )}
      <span class="rim" aria-hidden="true"></span>
    </span>
    <span class="face back">
      {back ? (
        <Image src={back} alt={`${site.name}, another photo`} width={224} height={224} />
      ) : (
        <span class="placeholder alt" aria-hidden="true">hi!</span>
      )}
      <span class="rim" aria-hidden="true"></span>
    </span>
  </span>
  </span>
</button>

<style>
  .flip {
    display: block;
    width: var(--avatar); height: var(--avatar);
    padding: 0; border: 0; background: none; color: inherit;
    cursor: pointer;
    perspective: calc(var(--avatar) * 5);
    border-radius: 28%; /* focus ring roughly follows the squircle */
    -webkit-tap-highlight-color: transparent;
  }

  /* Outer layer: leans toward the mouse (angles set by the script below) */
  .tilt {
    display: block; width: 100%; height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(var(--lift, 1));
    transition: transform var(--duration-slow) var(--ease);
  }
  .tracking .tilt { --lift: 1.06; transition-duration: var(--duration-fast); }

  /* Inner layer: the flip itself */
  .card {
    position: relative; display: block; width: 100%; height: 100%;
    transform-style: preserve-3d;
    transition: transform var(--duration-slow) var(--ease);
  }
  .flipped .card { transform: rotateY(180deg); }

  .face {
    position: absolute; inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    mask: var(--mask-squircle) center / 100% 100% no-repeat; /* squircle shape */
  }
  .back { transform: rotateY(180deg); }
  .face :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* Soft light reflection that follows the pointer */
  .face::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgb(255 255 255 / .12), transparent 85%);
    opacity: 0;
    transition: opacity var(--duration);
  }
  .tracking .face::after { opacity: 1; }

  /* Rim: a thin squircle edge lit from the pointer side, shown on hover
     so the portrait reads like a solid object with a bevelled edge */
  .rim {
    --rim: var(--space-2);
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: radial-gradient(
      circle at var(--gx, 30%) var(--gy, 30%),
      rgb(255 255 255 / .85), rgb(255 255 255 / .2) 55%, rgb(0 0 0 / .3)
    );
    /* outer squircle minus a slightly smaller one = a ring */
    mask:
      var(--mask-squircle) center / 100% 100% no-repeat,
      var(--mask-squircle) center / calc(100% - 2 * var(--rim)) calc(100% - 2 * var(--rim)) no-repeat;
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    opacity: 0;
    transition: opacity var(--duration);
  }
  .tracking .rim { opacity: 1; }

  .placeholder {
    display: grid; place-items: center; width: 100%; height: 100%;
    background: var(--subtle); color: var(--muted);
    font-size: var(--text-lg); font-weight: var(--weight-medium); letter-spacing: var(--tracking-tighter);
  }
  /* Back side: subtle holographic sheen */
  .back {
    --holo: #ff7ad9 0%, #ffd46e 10%, #7dffc4 20%, #78cfff 30%, #c48bff 40%, #ff7ad9 50%;
  }
  .back::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    /* repeating iridescent bands, shifted by the pointer */
    background: repeating-linear-gradient(115deg, var(--holo));
    background-size: 200% 200%;
    background-position: var(--gx, 30%) var(--gy, 30%);
    mix-blend-mode: multiply;
    opacity: .15; /* over a photo: keep it subtle */
    transition: background-position var(--duration-fast) linear;
  }
  /* Silvery base so the sheen reads in light and dark mode */
  .placeholder.alt {
    background: linear-gradient(135deg, #e8e8ee, #c9c9d4 50%, #ececf2);
    color: #1d1d22;
  }
  .back:has(.alt)::before { opacity: .3; } /* a bit stronger on the plain "hi!" side */

  /* No mouse (phones): let the sheen drift on its own while the back shows */
  @media (hover: none) {
    .flipped .back::before { animation: holo-drift 6s ease-in-out infinite alternate; }
  }
  @keyframes holo-drift {
    from { background-position: 0% 0%; }
    to   { background-position: 100% 100%; }
  }
</style>

<script>
  const MAX_TILT = 16; // degrees at the very edge of the portrait
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLButtonElement>('.flip').forEach((button) => {
    // Click / tap / Enter / Space: flip
    button.addEventListener('click', () => {
      const flipped = button.classList.toggle('flipped');
      button.setAttribute('aria-pressed', String(flipped));
    });

    if (reduced) return;

    // Mouse only: lean toward the pointer like a 3D object
    let frame = 0;
    button.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = button.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5; // -0.5 (left) … 0.5 (right)
        const y = (e.clientY - r.top) / r.height - 0.5; // -0.5 (top) … 0.5 (bottom)
        button.classList.add('tracking');
        button.style.setProperty('--ry', `${x * 2 * MAX_TILT}deg`);
        button.style.setProperty('--rx', `${-y * 2 * MAX_TILT}deg`);
        button.style.setProperty('--gx', `${(x + 0.5) * 100}%`);
        button.style.setProperty('--gy', `${(y + 0.5) * 100}%`);
      });
    });
    button.addEventListener('pointerleave', () => {
      cancelAnimationFrame(frame);
      button.classList.remove('tracking');
      ['--rx', '--ry', '--gx', '--gy'].forEach((p) => button.style.removeProperty(p));
    });
  });
</script>
