---
// Squircle portrait that flips over on click / tap to reveal a second image.
// Images: src/assets/portrait.(jpg|png|webp) for the front,
//         src/assets/portrait-back.(jpg|png|webp) for the back.
// Until they exist, placeholders are shown.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../site';

const fronts = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const backs = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait-back.{jpg,jpeg,png,webp}', { eager: true });
const front = Object.values(fronts)[0]?.default;
const back = Object.values(backs)[0]?.default;
const initials = site.name.split(' ').map((n) => n[0]).join('');
---

<button type="button" class="flip" aria-pressed="false" aria-label={`Flip ${site.name}'s portrait`}>
  <span class="card">
    <span class="face front">
      {front ? (
        <Image src={front} alt={site.name} width={224} height={224} loading="eager" />
      ) : (
        <span class="placeholder" aria-hidden="true">{initials}</span>
      )}
    </span>
    <span class="face back">
      {back ? (
        <Image src={back} alt={`${site.name}, another photo`} width={224} height={224} />
      ) : (
        <span class="placeholder alt" aria-hidden="true">hi!</span>
      )}
    </span>
  </span>
</button>

<style>
  .flip {
    display: block;
    width: var(--avatar); height: var(--avatar);
    padding: 0; border: 0; background: none; color: inherit;
    cursor: pointer;
    perspective: calc(var(--avatar) * 6);
    border-radius: 28%; /* focus ring roughly follows the squircle */
    -webkit-tap-highlight-color: transparent;
  }
  .card {
    position: relative; display: block; width: 100%; height: 100%;
    transform-style: preserve-3d;
    transition: transform var(--duration-slow) var(--ease);
  }
  .flipped .card { transform: rotateY(180deg); }
  /* A small tilt on hover hints that it can be turned */
  @media (hover: hover) {
    .flip:hover .card { transform: rotateY(-14deg); }
    .flip.flipped:hover .card { transform: rotateY(166deg); }
  }

  .face {
    position: absolute; inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    mask: var(--mask-squircle) center / 100% 100% no-repeat; /* squircle shape */
  }
  .back { transform: rotateY(180deg); }
  .face :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .placeholder {
    display: grid; place-items: center; width: 100%; height: 100%;
    background: var(--subtle); color: var(--muted);
    font-size: var(--text-lg); font-weight: var(--weight-medium); letter-spacing: var(--tracking-tighter);
  }
  .placeholder.alt { background: var(--fg); color: var(--bg); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.flip').forEach((button) => {
    button.addEventListener('click', () => {
      const flipped = button.classList.toggle('flipped');
      button.setAttribute('aria-pressed', String(flipped));
    });
  });
</script>
