---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Lead from '../components/Lead.astro';
import Section from '../components/Section.astro';
import ListRow from '../components/ListRow.astro';
import DateLabel from '../components/DateLabel.astro';
import MoreLink from '../components/MoreLink.astro';
import { site, url } from '../site';

const byDateDesc = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(byDateDesc).slice(0, 5);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(byDateDesc);
---

<Base>
  <div class="wrap">
    <Lead class="intro">{site.intro}</Lead>

    <div class="fade-in">
      <Section label="journal" icon="journal">
        {posts.length > 0 ? (
          <ul>
            {posts.map((post) => (
              <ListRow href={url(`/journal/${post.id}/`)}>
                {post.data.title}
                <DateLabel slot="meta" date={post.data.date} format="short" />
              </ListRow>
            ))}
          </ul>
        ) : (
          <p class="muted">Nothing here yet.</p>
        )}
        <MoreLink href={url('/journal/')}>all posts</MoreLink>
      </Section>

      <Section label="work" icon="work">
        <ul>
          {projects.map((project) => (
            <ListRow href={url(`/work/${project.id}/`)}>
              {project.data.title}{' '}<span class="muted kind">{project.data.kind}</span>
              <span slot="meta" class="mono muted">{project.data.date.getUTCFullYear()}</span>
            </ListRow>
          ))}
        </ul>
        <MoreLink href={url('/work/')}>all work</MoreLink>
      </Section>

      <Section label="about" icon="user">
        <p class="about">{site.about[0]}</p>
        <MoreLink href={url('/about/')}>more about me</MoreLink>
      </Section>
    </div>
  </div>
</Base>

<style>
  .wrap :global(.intro) { max-width: 30ch; margin-bottom: var(--space-48); }
  .about { color: var(--fg-soft); }
  .kind { margin-left: var(--space-4); } /* + the space character ≈ 8px */
</style>
