---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Icon from '../components/Icon.astro';
import { site, url, monthYear } from '../site';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <div class="wrap">
    <p class="intro" data-lines>{site.intro}</p>

    <ol class="feed fade-in">
      {projects.map((project, i) => {
        const href = url(`/work/${project.id}/`);
        const { title, date, summary, quote } = project.data;
        return (
          <li class="entry">
            <time class="mono muted" datetime={date.toISOString()}>{monthYear(date)}</time>
            <h2><a class="link" href={href}>{title}<Icon name="arrow" size={16} class="arrow" /></a></h2>
            <a href={href} class="media-link" tabindex="-1" aria-hidden="true">
              <ProjectMedia project={project} eager={i === 0} />
            </a>
            <p class="summary">{summary}</p>
            {quote && (
              <blockquote>
                <p>“{quote.text}”</p>
                <footer class="muted">— {quote.source}</footer>
              </blockquote>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</Base>

<style>
  .intro { font-size: 20px; line-height: 1.45; letter-spacing: -.015em; max-width: 30ch; margin-bottom: 72px; }
  .feed { display: grid; gap: 96px; }
  .entry time { display: block; }
  h2 { font-size: 20px; font-weight: 500; letter-spacing: -.02em; margin: 2px 0 16px; }
  h2 a { display: inline-flex; align-items: center; gap: 6px; }
  h2 :global(.arrow) { color: var(--muted); transition: transform .4s var(--ease), color .2s; }
  h2 a:hover :global(.arrow) { transform: translate(2px, -2px); color: var(--fg); }
  .media-link { display: block; }
  .media-link :global(.media-inner) { transition: transform .8s var(--ease); }
  .media-link:hover :global(.media-inner) { transform: scale(1.025); }
  .summary { margin-top: 16px; color: color-mix(in srgb, var(--fg) 82%, var(--bg)); }
  blockquote { margin-top: 20px; padding-left: 16px; border-left: 2px solid var(--line); }
  blockquote p { font-style: italic; }
</style>
