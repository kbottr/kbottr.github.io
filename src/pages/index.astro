---
// Home: who you are — intro and contact — and your selected work.
// (The current role sits in the footer, see components/CurrentRole.astro.)
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Lead from '../components/Lead.astro';
import Section from '../components/Section.astro';
import ListRow from '../components/ListRow.astro';
import MoreLink from '../components/MoreLink.astro';
import Link from '../components/Link.astro';
import { site, url } from '../site';

const byDateDesc = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(byDateDesc);
---

<Base>
  <div class="wrap">
    <section class="hero">
      <Lead class="intro">{site.intro}</Lead>
      <div class="fade-in">
        <p class="contact">
          <Link href={`mailto:${site.email}`}>send me a mail</Link>
        </p>
      </div>
    </section>

    <div class="fade-in">
      <Section label="selected work" icon="work">
        <ul>
          {projects.map((project) => (
            <ListRow href={url(`/work/${project.id}/`)}>
              {project.data.title}{' '}<span class="muted kind">{project.data.kind}</span>
              <span slot="meta" class="mono muted">{project.data.date.getUTCFullYear()}</span>
            </ListRow>
          ))}
        </ul>
        <MoreLink href={url('/work/')}>all work</MoreLink>
      </Section>
    </div>
  </div>
</Base>

<style>
  .hero { margin-bottom: var(--space-48); }
  .wrap :global(.intro) { max-width: 30ch; }

  .contact {
    display: flex; flex-wrap: wrap; gap: var(--space-16);
    margin-top: var(--space-24);
    font-size: var(--text-sm); line-height: var(--leading-sm);
  }

  .kind { margin-left: var(--space-4); } /* + the space character ≈ 8px */
</style>
