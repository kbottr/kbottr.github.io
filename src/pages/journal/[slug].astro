---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, monthYear } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, description } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description}>
  <article class="wrap">
    <time class="mono muted" datetime={date.toISOString()}>{monthYear(date)}</time>
    <h1 data-lines>{title}</h1>
    <div class="prose fade-in">
      <Content />
    </div>
    <nav class="pager">
      <a class="link muted" href={url('/journal/')}>← journal</a>
    </nav>
  </article>
</Base>

<style>
  h1 { font-size: 26px; font-weight: 500; letter-spacing: -.025em; line-height: 1.25; margin: 4px 0 32px; }
  .pager { margin-top: 80px; padding-top: 20px; border-top: 1px solid var(--line); }
</style>
