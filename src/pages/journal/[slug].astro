---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DateLabel from '../../components/DateLabel.astro';
import Pager from '../../components/Pager.astro';
import { url } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, description } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description}>
  <article class="wrap">
    <DateLabel date={date} />
    <h1 data-lines>{title}</h1>
    <div class="prose fade-in">
      <Content />
    </div>
    <Pager back={{ href: url('/journal/'), label: 'journal' }} />
  </article>
</Base>

<style>
  h1 {
    margin: var(--space-4) 0 var(--space-32);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tighter);
  }
</style>
