---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ListRow from '../../components/ListRow.astro';
import DateLabel from '../../components/DateLabel.astro';
import { url } from '../../site';

const posts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Journal" description="Thoughts, notes and things I'm learning.">
  <div class="wrap">
    <h1 data-lines>journal</h1>
    <p class="muted fade-in">Thoughts, notes and things I'm learning.</p>

    {posts.length > 0 ? (
      <ul class="list fade-in">
        {posts.map((post) => (
          <ListRow href={url(`/journal/${post.id}/`)}>
            {post.data.title}
            <DateLabel slot="meta" date={post.data.date} format="short" />
          </ListRow>
        ))}
      </ul>
    ) : (
      <p class="muted empty">Nothing here yet.</p>
    )}
  </div>
</Base>

<style>
  h1 { font-size: var(--text-base); line-height: var(--leading-base); font-weight: var(--weight-medium); }
  .list { margin-top: var(--space-40); }
  .empty { margin-top: var(--space-40); }
</style>
