---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ListRow from '../../components/ListRow.astro';
import DateLabel from '../../components/DateLabel.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../site';

const posts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Journal" description="Thoughts, notes and things I'm learning.">
  <div class="wrap">
    <PageHeader title="journal" description="Thoughts, notes and things I'm learning." />

    {posts.length > 0 ? (
      <ul class="list fade-in">
        {posts.map((post) => (
          <ListRow href={url(`/journal/${post.id}/`)}>
            {post.data.title}
            <DateLabel slot="meta" date={post.data.date} format="short" />
          </ListRow>
        ))}
      </ul>
    ) : (
      <p class="muted empty">Nothing here yet.</p>
    )}
  </div>
</Base>

