---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Marquee from '../../components/Marquee.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Lead from '../../components/Lead.astro';
import Pager from '../../components/Pager.astro';
import { url } from '../../site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { title, summary, role, kind, date, team } = project.data;
const { Content } = await render(project);

const facts = [
  { label: 'role', value: role },
  { label: 'type', value: kind },
  { label: 'year', value: String(date.getUTCFullYear()) },
  ...(team ? [{ label: 'team', value: team }] : []),
];
---

<Base title={title} description={summary}>
  <Marquee text={title} />

  <div class="wrap">
    <Lead delay={200} class="summary">{summary}</Lead>

    <dl class="facts mono fade-in">
      {facts.map((f) => (
        <div><dt class="muted">{f.label}</dt><dd>{f.value}</dd></div>
      ))}
    </dl>

    <ProjectMedia project={project} eager />

    <article class="prose">
      <Content />
    </article>

    <Pager
      back={{ href: url('/'), label: 'all work' }}
      next={next.id !== project.id ? { href: url(`/work/${next.id}/`), label: next.data.title } : undefined}
    />
  </div>
</Base>

<style>
  .wrap :global(.summary) { margin-top: var(--space-24); }
  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(var(--space-128), 1fr)); gap: var(--space-16);
    margin-block: var(--space-40);
    padding-block: var(--space-24);
    border-block: var(--border) solid var(--line);
  }
  dd { margin-top: var(--space-2); }
  .prose { margin-top: var(--space-48); }
</style>
