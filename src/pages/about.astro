---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, url, shortMonthYear } from '../site';

// Drop a photo at src/assets/portrait.jpg (or .png/.webp) and it appears here.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;
const initials = site.name.split(' ').map((n) => n[0]).join('');

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const experience = (await getCollection('experience')).sort(byOrder);
const music = (await getCollection('music')).sort(byOrder);
const goals = (await getCollection('goals')).sort(byOrder);
const posts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="About" description={site.about[0]}>
  <div class="wrap">
    <section class="intro">
      <div class="side">
        {portrait ? (
          <Image src={portrait} alt={site.name} width={200} height={200} class="portrait" loading="eager" />
        ) : (
          <div class="portrait placeholder" aria-hidden="true">{initials}</div>
        )}
      </div>
      <div class="bio">
        {site.about.map((p, i) => (i === 0 ? <p data-lines>{p}</p> : <p class="fade-in">{p}</p>))}
        <p class="socials fade-in">
          {site.socials.map((s) => <a class="link underlined" href={s.href}>{s.label}</a>)}
          <a class="link underlined" href={`mailto:${site.email}`}>Email</a>
        </p>
      </div>
    </section>

    <div class="fade-in">
      <section class="row">
        <h2><Icon name="briefcase" size={15} /> experience</h2>
        <ul class="experience">
          {experience.map(({ data }) => (
            <li>
              <div>
                <div>{data.role}</div>
                <div class="muted">{data.company}</div>
              </div>
              <div class="dates mono muted">
                {data.start} – {data.end ?? <span class="pill">present</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="row">
        <h2><Icon name="journal" size={15} /> journal</h2>
        <div>
          {posts.length > 0 ? (
            <ul class="posts">
              {posts.map((post) => (
                <li>
                  <a class="link" href={url(`/journal/${post.id}/`)}>{post.data.title}</a>
                  <span class="mono muted">{shortMonthYear(post.data.date)}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">Nothing here yet.</p>
          )}
          <a class="link muted all" href={url('/journal/')}>all posts →</a>
        </div>
      </section>

      <section class="row">
        <h2><Icon name="headphones" size={15} /> music</h2>
        <ul class="music">
          {music.map(({ data }) => {
            const Tag = data.href ? 'a' : 'div';
            return (
              <li>
                <Tag class="track" href={data.href}>
                  {data.cover ? (
                    <img src={data.cover.startsWith('/') ? url(data.cover) : data.cover} alt="" width="48" height="48" loading="lazy" />
                  ) : (
                    <span class="cover" aria-hidden="true" />
                  )}
                  <span>
                    <span class:list={['title', { link: data.href }]}>{data.title}</span>
                    <span class="muted artist">{data.artist}</span>
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </section>

      <section class="row">
        <h2><Icon name="flag" size={15} /> goals</h2>
        <ul class="goals">
          {goals.map(({ data }) => (
            <li class={data.status}>
              {data.status === 'done' ? <s>{data.text}</s> : data.text}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .intro {
    display: grid; grid-template-columns: 140px 1fr; gap: 32px;
    padding-bottom: 48px; border-bottom: 1px solid var(--line);
  }
  .portrait { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; }
  .portrait.placeholder {
    display: grid; place-items: center;
    background: var(--subtle); color: var(--muted);
    font: 500 28px var(--sans); letter-spacing: -.03em;
  }
  .bio > * + * { margin-top: 1em; }
  .bio p:first-child { font-size: 17px; line-height: 1.5; letter-spacing: -.01em; }
  .socials { display: flex; gap: 16px; flex-wrap: wrap; }

  .row {
    display: grid; grid-template-columns: 140px 1fr; gap: 32px;
    padding-block: 32px; border-bottom: 1px solid var(--line);
  }
  .row:last-child { border-bottom: 0; }
  h2 {
    display: flex; align-items: center; gap: 8px; align-self: start;
    font-size: 15px; font-weight: 400; color: var(--muted);
  }

  .experience { display: grid; gap: 18px; }
  .experience li { display: flex; justify-content: space-between; gap: 16px; }
  .dates { white-space: nowrap; padding-top: 2px; }
  .pill {
    display: inline-block; padding: 0 8px; border-radius: 999px;
    background: var(--accent-bg); color: var(--accent);
  }

  .posts { display: grid; gap: 8px; }
  .posts li { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  .posts .mono { flex-shrink: 0; }
  .all { display: inline-block; margin-top: 16px; font-size: 13px; }

  .music { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; }
  .track { display: flex; gap: 12px; align-items: center; }
  .track img, .cover {
    width: 48px; height: 48px; flex-shrink: 0; border-radius: 6px; object-fit: cover;
  }
  .cover { background: linear-gradient(135deg, var(--subtle), var(--line)); }
  .title, .artist { display: block; width: fit-content; }
  .artist { font-size: 13px; }

  .goals { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 24px; }
  .goals .done { color: var(--muted); }
  .goals .doing { color: var(--accent); }
  .goals .doing::before { content: '•'; margin-left: -12px; width: 12px; display: inline-block; }

  @media (max-width: 600px) {
    .intro, .row { grid-template-columns: 1fr; gap: 16px; }
    .music, .goals { grid-template-columns: 1fr; }
  }
</style>
