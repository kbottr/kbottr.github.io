---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ListRow from '../components/ListRow.astro';
import Pill from '../components/Pill.astro';
import Link from '../components/Link.astro';
import DateLabel from '../components/DateLabel.astro';
import MoreLink from '../components/MoreLink.astro';
import Track from '../components/Track.astro';
import { site, url } from '../site';

// Drop a photo at src/assets/portrait.jpg (or .png/.webp) and it appears here.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;
const initials = site.name.split(' ').map((n) => n[0]).join('');

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const experience = (await getCollection('experience')).sort(byOrder);
const music = (await getCollection('music')).sort(byOrder);
const goals = (await getCollection('goals')).sort(byOrder);
const posts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="About" description={site.about[0]}>
  <div class="wrap">
    <section class="intro">
      <div>
        {portrait ? (
          <Image src={portrait} alt={site.name} width={224} height={224} class="portrait" loading="eager" />
        ) : (
          <div class="portrait placeholder" aria-hidden="true">{initials}</div>
        )}
      </div>
      <div class="bio">
        {site.about.map((p, i) => (i === 0 ? <p class="first" data-lines>{p}</p> : <p class="fade-in">{p}</p>))}
        <p class="socials fade-in">
          {site.socials.map((s) => <Link variant="underlined" href={s.href}>{s.label}</Link>)}
          <Link variant="underlined" href={`mailto:${site.email}`}>Email</Link>
        </p>
      </div>
    </section>

    <div class="fade-in">
      <Section label="experience" icon="briefcase">
        <ul class="stack">
          {experience.map(({ data }) => (
            <ListRow>
              <span class="block">{data.role}</span>
              <span class="block muted">{data.company}</span>
              <span slot="meta" class="mono muted">
                {data.start} – {data.end ?? <Pill>present</Pill>}
              </span>
            </ListRow>
          ))}
        </ul>
      </Section>

      <Section label="journal" icon="journal">
        {posts.length > 0 ? (
          <ul>
            {posts.map((post) => (
              <ListRow href={url(`/journal/${post.id}/`)}>
                {post.data.title}
                <DateLabel slot="meta" date={post.data.date} format="short" />
              </ListRow>
            ))}
          </ul>
        ) : (
          <p class="muted">Nothing here yet.</p>
        )}
        <MoreLink href={url('/journal/')}>all posts</MoreLink>
      </Section>

      <Section label="music" icon="headphones">
        <ul class="stack">
          {music.map(({ data }) => <Track {...data} />)}
        </ul>
      </Section>

      <Section label="goals" icon="flag">
        <ul class="grid-2 goals">
          {goals.map(({ data }) => (
            <li class={data.status}>
              {data.status === 'done' ? <s>{data.text}</s> : data.text}
            </li>
          ))}
        </ul>
      </Section>
    </div>
  </div>
</Base>

<style>
  .intro {
    display: grid; grid-template-columns: var(--label-col) 1fr; gap: var(--space-32);
    padding-bottom: var(--space-48);
    border-bottom: var(--border) solid var(--line);
  }
  .portrait { width: var(--avatar); height: var(--avatar); border-radius: var(--radius-full); object-fit: cover; }
  .portrait.placeholder {
    display: grid; place-items: center;
    background: var(--subtle); color: var(--muted);
    font-size: var(--text-lg); font-weight: var(--weight-medium); letter-spacing: var(--tracking-tighter);
  }
  .bio > * + * { margin-top: var(--space-16); }
  .bio .first { font-size: var(--text-md); line-height: var(--leading-md); letter-spacing: var(--tracking-tight); }
  .socials { display: flex; gap: var(--space-16); flex-wrap: wrap; }

  .block { display: block; width: fit-content; }
  .stack { display: grid; gap: var(--space-16); }

  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-16) var(--space-24); }

  .goals { row-gap: var(--space-4); }
  .goals .done { color: var(--muted); }
  .goals .doing { color: var(--accent); }
  .goals .doing::before { content: '•'; display: inline-block; width: var(--space-12); margin-left: calc(-1 * var(--space-12)); }

  @media (max-width: 600px) {
    .intro { grid-template-columns: 1fr; gap: var(--space-16); }
    .grid-2 { grid-template-columns: 1fr; }
  }
</style>
