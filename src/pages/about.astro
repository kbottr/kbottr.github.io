---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PortraitFlip from '../components/PortraitFlip.astro';
import ListRow from '../components/ListRow.astro';
import Pill from '../components/Pill.astro';
import Link from '../components/Link.astro';
import DateLabel from '../components/DateLabel.astro';
import MoreLink from '../components/MoreLink.astro';
import Track from '../components/Track.astro';
import Challenge from '../components/Challenge.astro';
import PhotoStack from '../components/PhotoStack.astro';
import { site, url } from '../site';


const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const experience = (await getCollection('experience')).sort(byOrder);
const music = (await getCollection('music')).sort(byOrder);
const challenges = (await getCollection('challenges')).sort(byOrder);
const moments = (await getCollection('moments')).sort(byOrder).map((m) => m.data);
const posts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="About" description={site.about[0]}>
  <div class="wrap">
    <section class="intro">
      <PortraitFlip />
      <div class="bio">
        {site.about.map((p, i) => (i === 0 ? <p class="first" data-lines>{p}</p> : <p class="fade-in">{p}</p>))}
        <p class="socials fade-in">
          {site.socials.map((s) => <Link variant="underlined" href={s.href}>{s.label}</Link>)}
          <Link variant="underlined" href={`mailto:${site.email}`}>Email</Link>
        </p>
      </div>
    </section>

    <div class="fade-in">
      {moments.length > 0 && (
        <Section label="moments" icon="images">
          <PhotoStack items={moments} />
        </Section>
      )}

      <Section label="experience" icon="briefcase">
        <ul class="stack">
          {experience.map(({ data }) => (
            <ListRow>
              <span class="block">{data.role}</span>
              <span class="block muted">{data.company}</span>
              <span slot="meta" class="mono muted">
                {data.start} – {data.end ?? <Pill>present</Pill>}
              </span>
            </ListRow>
          ))}
        </ul>
      </Section>

      <Section label="journal" icon="journal">
        {posts.length > 0 ? (
          <ul>
            {posts.map((post) => (
              <ListRow href={url(`/journal/${post.id}/`)}>
                {post.data.title}
                <DateLabel slot="meta" date={post.data.date} format="short" />
              </ListRow>
            ))}
          </ul>
        ) : (
          <p class="muted">Nothing here yet.</p>
        )}
        <MoreLink href={url('/journal/')}>all posts</MoreLink>
      </Section>

      <Section label="music" icon="headphones">
        <ul class="stack">
          {music.map(({ data }) => <Track {...data} />)}
        </ul>
      </Section>

      <Section label="challenges" icon="flag">
        <ul class="challenges">
          {challenges.map(({ data }) => <Challenge done={data.done} subline={data.subline}>{data.text}</Challenge>)}
        </ul>
      </Section>
    </div>
  </div>
</Base>

<style>
  .intro {
    display: flex; flex-direction: column; gap: var(--space-24); /* portrait on top of the bio */
    padding-bottom: var(--space-48);
  }
  .bio > * + * { margin-top: var(--space-16); }
  .bio .first { font-size: var(--text-md); line-height: var(--leading-md); letter-spacing: var(--tracking-tight); }
  .socials { display: flex; gap: var(--space-16); flex-wrap: wrap; }

  .block { display: block; width: fit-content; }
  .stack { display: grid; gap: var(--space-16); }


  .challenges { display: grid; gap: var(--space-8); }

</style>
