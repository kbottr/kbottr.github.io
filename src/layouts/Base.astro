---
import '../styles/global.css';
import Dock from '../components/Dock.astro';
import { site, url } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.intro } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title ? `${title} — ${site.brand}` : site.title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="wrap site-header">
      <a href={url('/')} class="brand">{site.brand}</a>
      <span class="muted">{site.role}</span>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap site-footer muted">
      <span>
        © {new Date().getFullYear()} {site.name}
        <span class="credit">{" "}· Icons by <a class="link underlined" href="https://lucide.dev">Lucide</a></span>
      </span>
      <span class="links">
        {site.socials.map((s) => <a class="link" href={s.href}>{s.label}</a>)}
      </span>
    </footer>

    <Dock />

    <script>
      // Line-by-line reveal for elements marked data-lines.
      // Splits plain text into lines, slides each up from a mask,
      // then restores the original text so it reflows normally.
      const els = document.querySelectorAll<HTMLElement>('[data-lines]');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      function split(el: HTMLElement, delay = 0) {
        const original = el.innerHTML;
        const words = (el.textContent ?? '').trim().split(/\s+/);
        el.textContent = '';
        const spans = words.map((w, i) => {
          const s = document.createElement('span');
          s.textContent = w;
          el.append(s, i < words.length - 1 ? ' ' : '');
          return s;
        });
        const lines: string[][] = [];
        let top: number | null = null;
        for (const s of spans) {
          if (s.offsetTop !== top) { lines.push([]); top = s.offsetTop; }
          lines[lines.length - 1].push(s.textContent ?? '');
        }
        el.textContent = '';
        lines.forEach((words, i) => {
          const line = document.createElement('span');
          line.className = 'line';
          const inner = document.createElement('span');
          inner.textContent = words.join(' ');
          inner.style.animationDelay = `${delay + i * 90}ms`;
          line.append(inner);
          el.append(line);
        });
        el.classList.add('split-done');
        const last = el.querySelector<HTMLElement>('.line:last-child > span');
        last?.addEventListener('animationend', () => { el.innerHTML = original; }, { once: true });
      }

      if (reduced) {
        els.forEach((el) => el.classList.add('split-done'));
      } else {
        document.fonts.ready.then(() => {
          els.forEach((el) => split(el, Number(el.dataset.delay ?? 0)));
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    view-transition-name: header;
    display: flex; flex-direction: column;
    padding-top: clamp(40px, 8vh, 80px);
    padding-bottom: clamp(40px, 7vh, 72px);
    line-height: 1.5;
  }
  .brand { font-weight: 600; letter-spacing: -.02em; width: fit-content; }
  main { min-height: 60vh; }
  .site-footer {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding-top: 96px; padding-bottom: 120px; /* room for the dock */
    font-size: 13px;
  }
  .links { display: flex; gap: 16px; }
  .credit { white-space: nowrap; }
</style>
