---
import '../styles/global.css';
import Dock from '../components/Dock.astro';
import Link from '../components/Link.astro';
import { site, url } from '../site';
// The two font files every page needs; preloaded so text can show sooner
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (e.g. the 404 page) */
  noindex?: boolean;
}

const { title, description = site.intro, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.brand}` : site.title;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex ? <meta name="robots" content="noindex" /> : canonical && <link rel="canonical" href={canonical} />}

    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />

    {/* Browser chrome (e.g. Safari's toolbar) matches the page in light and dark mode */}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    {/* Link previews (LinkedIn, iMessage, Slack, …) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="wrap site-header">
      <a href={url('/')} class="brand">{site.brand}</a>
      <span class="muted">{site.role}</span>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap site-footer muted">
      <div class="footer-row">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="links">
          {site.socials.map((s) => <Link href={s.href}>{s.label}</Link>)}
        </span>
      </div>
      <p class="credit">Icons by <Link variant="underlined" href="https://lucide.dev">Lucide</Link></p>
    </footer>

    <Dock />

    <script>
      // Line-by-line reveal for elements marked data-lines.
      // Splits plain text into lines, slides each up from a mask,
      // then restores the original text so it reflows normally.
      const els = document.querySelectorAll<HTMLElement>('[data-lines]');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Delay between lines comes from the --stagger token (e.g. "90ms")
      const stagger = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--stagger')) || 90;

      function split(el: HTMLElement, delay = 0) {
        const original = el.innerHTML;
        const words = (el.textContent ?? '').trim().split(/\s+/);
        el.textContent = '';
        const spans = words.map((w, i) => {
          const s = document.createElement('span');
          s.textContent = w;
          el.append(s, i < words.length - 1 ? ' ' : '');
          return s;
        });
        const lines: string[][] = [];
        let top: number | null = null;
        for (const s of spans) {
          if (s.offsetTop !== top) { lines.push([]); top = s.offsetTop; }
          lines[lines.length - 1].push(s.textContent ?? '');
        }
        el.textContent = '';
        lines.forEach((words, i) => {
          const line = document.createElement('span');
          line.className = 'line';
          const inner = document.createElement('span');
          inner.textContent = words.join(' ');
          inner.style.animationDelay = `${delay + i * stagger}ms`;
          line.append(inner);
          el.append(line);
        });
        el.classList.add('split-done');
        const last = el.querySelector<HTMLElement>('.line:last-child > span');
        last?.addEventListener('animationend', () => { el.innerHTML = original; }, { once: true });
      }

      if (reduced) {
        els.forEach((el) => el.classList.add('split-done'));
      } else {
        document.fonts.ready.then(() => {
          els.forEach((el) => split(el, Number(el.dataset.delay ?? 0)));
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    view-transition-name: header;
    display: flex; flex-direction: column;
    padding-top: var(--space-64);
    padding-bottom: var(--space-64);
  }
  .brand {
    width: fit-content;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tighter);
  }
  main { min-height: 60vh; }
  .site-footer {
    padding-top: var(--space-96);
    padding-bottom: var(--space-128); /* room for the dock */
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }
  .footer-row { display: flex; justify-content: space-between; gap: var(--space-16); flex-wrap: wrap; }
  .links { display: flex; gap: var(--space-16); }
  .credit {
    margin-top: var(--space-24);
  }
</style>
